# Server-only credentials. Never place these in frontend/ or commit .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
# Alternatively: SUPABASE_SERVICE_ROLE_KEY (service_role or secret key, not anon)

# Shopify Admin API token with read_orders. Older orders require read_all_orders.
# API key / client secret alone are NOT an Admin API access token.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
